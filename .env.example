# PaySure — UPI Payment Reliability Lab (SANDBOX ONLY — no real money moves)
# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (system of record) ---
POSTGRES_DB=paysure
POSTGRES_USER=paysure
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Redis (rate limits / caches; Phase 4) ---
REDIS_PORT=6379

# --- Kafka (event bus via transactional outbox; Phase 4) ---
KAFKA_PORT=9092

# --- Backend ---
BACKEND_PORT=8080
# HMAC secret for signing JWTs. MUST be >= 32 bytes. Generate with:
#   openssl rand -base64 48
PAYSURE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PAYSURE_JWT_TTL_MINUTES=60
# Comma-separated list of browser origins allowed to call the API
PAYSURE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Seed demo users (ananya, rahul, admin) on startup. Sandbox only.
PAYSURE_SEED_ENABLED=true
PAYSURE_DEMO_PASSWORD=Sandbox@123
# Enables /api/dev/** sandbox tools (balance top-up). Requires ADMIN_DEMO role.
PAYSURE_DEV_TOOLS_ENABLED=true

# --- Webhooks / events (Phase 4) ---
# Server key that webhook signing secrets are derived from. Leave blank to derive from PAYSURE_JWT_SECRET.
PAYSURE_WEBHOOK_SECRET_KEY=
# Built-in sandbox webhook receiver for local demos, and the ONLY private host:port webhooks may target.
PAYSURE_WEBHOOK_SANDBOX_RECEIVER=true
PAYSURE_WEBHOOK_LOCAL_ALLOWLIST=localhost:8080
# Trust X-Forwarded-For for per-IP rate limits (only behind the bundled nginx / your own proxy).
PAYSURE_RATE_LIMIT_TRUST_XFF=true

# --- Monitoring (Prometheus + Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Grafana admin password (local sandbox only; choose your own)
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Frontend ---
FRONTEND_PORT=3000
